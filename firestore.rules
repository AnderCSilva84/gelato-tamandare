rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function panelAccessPath(uid) {
      return /databases/$(database)/documents/acessos_painel/$(uid);
    }

    function hasPanelAccess() {
      return isSignedIn() && exists(panelAccessPath(request.auth.uid));
    }

    function myPanelAccess() {
      return get(panelAccessPath(request.auth.uid));
    }

    function myRole() {
      return hasPanelAccess() ? myPanelAccess().data.role : null;
    }

    function isManagement() {
      return myRole() == "gerencia" || myRole() == "superadmin";
    }

    function isSuperadmin() {
      return myRole() == "superadmin";
    }

    function canManageProducts() {
      return isManagement()
        || (hasPanelAccess()
          && myPanelAccess().data.keys().hasAny(["podeGerenciarProdutos"])
          && myPanelAccess().data.podeGerenciarProdutos == true);
    }

    function hasStoreAccess(lojaId) {
      return hasPanelAccess() && (
        isSuperadmin()
        || (myPanelAccess().data.keys().hasAny(["lojaId"]) && myPanelAccess().data.lojaId == lojaId)
        || (myPanelAccess().data.keys().hasAny(["lojaIds"]) && lojaId in myPanelAccess().data.lojaIds)
      );
    }

    function canReadStoreData() {
      return resource.data.keys().hasAny(["uid"]) && hasStoreAccess(resource.data.uid);
    }

    function canCreateStoreData() {
      return request.resource.data.keys().hasAny(["uid"]) && hasStoreAccess(request.resource.data.uid);
    }

    function keepsStore() {
      return request.resource.data.uid == resource.data.uid;
    }

    function attendeePath(id) {
      return /databases/$(database)/documents/atendentes/$(id);
    }

    function attendeeDoc(id) {
      return get(attendeePath(id));
    }

    function attendeeExists(id) {
      return exists(attendeePath(id));
    }

    function isBootstrappableSuperadmin(id) {
      return attendeeExists(id)
        && attendeeDoc(id).data.role == "superadmin"
        && (attendeeDoc(id).data.authUid == null || attendeeDoc(id).data.authUid == "");
    }

    function isPromotingToSuperadmin() {
      return request.resource.data.role == "superadmin";
    }

    function isStoredSuperadmin() {
      return resource.data.role == "superadmin";
    }

    function isBootstrapBindingUpdate() {
      return isSignedIn()
        && resource.data.role == "superadmin"
        && (resource.data.authUid == null || resource.data.authUid == "")
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.nome == resource.data.nome
        && request.resource.data.meta == resource.data.meta
        && request.resource.data.senha == resource.data.senha
        && request.resource.data.ativo == resource.data.ativo;
    }

    match /acessos_painel/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperadmin());
      allow create: if isSignedIn() && (
        isSuperadmin()
        || (isManagement()
          && request.resource.data.role != "superadmin"
          && request.resource.data.keys().hasAny(["lojaId"])
          && hasStoreAccess(request.resource.data.lojaId))
        || (
          request.auth.uid == uid
          && isBootstrappableSuperadmin(request.resource.data.atendenteId)
          && request.resource.data.role == "superadmin"
        )
      );
      allow update: if isSignedIn() && (
        isSuperadmin()
        || (isManagement()
          && resource.data.role != "superadmin"
          && request.resource.data.role != "superadmin"
          && resource.data.keys().hasAny(["lojaId"])
          && hasStoreAccess(resource.data.lojaId)
          && request.resource.data.lojaId == resource.data.lojaId)
      );
      allow delete: if isSignedIn() && (
        isSuperadmin()
        || (isManagement()
          && resource.data.role != "superadmin"
          && resource.data.keys().hasAny(["lojaId"])
          && hasStoreAccess(resource.data.lojaId))
      );
    }

    match /atendentes/{document} {
      allow read: if canReadStoreData();
      allow create: if isManagement() && canCreateStoreData() && (!isPromotingToSuperadmin() || isSuperadmin());
      allow update: if isBootstrapBindingUpdate()
        || (isManagement() && canReadStoreData() && keepsStore()
          && !isStoredSuperadmin()
          && (!isPromotingToSuperadmin() || isSuperadmin()));
      allow delete: if isManagement() && canReadStoreData() && (!isStoredSuperadmin() || isSuperadmin());
    }

    match /configuracoes/{document} {
      allow read: if true;
      allow write: if isSuperadmin();
    }

    match /lojas/{lojaId} {
      allow read: if true;
      allow create: if isSuperadmin()
        || (isManagement() && request.resource.data.status == "ativa" && request.resource.data.ativa == true);
      allow update: if isSuperadmin()
        || (isManagement()
          && resource.data.status == "ativa"
          && request.resource.data.status == "ativa"
          && request.resource.data.ativa == true);
      allow delete: if isSuperadmin();
    }

    match /produtos/{document=**} {
      allow read: if canReadStoreData();
      allow create: if canManageProducts() && canCreateStoreData();
      allow update: if canReadStoreData() && keepsStore() && (
        canManageProducts()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estoque"])
      );
      allow delete: if canManageProducts() && canReadStoreData();
    }

    match /grupos_produtos/{document=**} {
      allow read: if canReadStoreData();
      allow create: if canManageProducts() && canCreateStoreData();
      allow update, delete: if canManageProducts() && canReadStoreData() && keepsStore();
    }

    match /vendas/{document=**} {
      allow read, delete: if canReadStoreData();
      allow create: if canCreateStoreData();
      allow update: if isManagement() && canReadStoreData() && keepsStore();
    }

    match /despesas/{document=**} {
      allow read, delete: if canReadStoreData();
      allow create: if canCreateStoreData();
      allow update: if isManagement() && canReadStoreData() && keepsStore();
    }

    match /despesas_fixas/{document=**} {
      allow read, delete: if isManagement() && canReadStoreData();
      allow create: if isManagement() && canCreateStoreData();
      allow update: if isManagement() && canReadStoreData() && keepsStore();
    }

    match /entradas_consolidadas/{document=**} {
      allow read, delete: if canReadStoreData();
      allow create: if canCreateStoreData();
      allow update: if isManagement() && canReadStoreData() && keepsStore();
    }

    match /caixas/{document=**} {
      allow read, delete: if canReadStoreData();
      allow create: if canCreateStoreData();
      allow update: if canReadStoreData() && keepsStore();
    }

    match /retiradas_caixa/{document=**} {
      allow read, delete: if canReadStoreData();
      allow create: if canCreateStoreData();
      allow update: if canReadStoreData() && keepsStore();
    }

    match /resumo_diario/{document=**} {
      allow read, delete: if canReadStoreData();
      allow create: if canCreateStoreData();
      allow update: if canReadStoreData() && keepsStore();
    }

    match /ranking_diario/{document=**} {
      allow read, delete: if canReadStoreData();
      allow create: if canCreateStoreData();
      allow update: if canReadStoreData() && keepsStore();
    }

    match /lancamentos/{document=**} {
      allow read, delete: if canReadStoreData();
      allow create: if canCreateStoreData();
      allow update: if isManagement() && canReadStoreData() && keepsStore();
    }

    match /conversas/{conversaId} {
      allow read, create, update: if true;
      allow delete: if false;

      match /mensagens/{mensagemId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }
  }
}
