rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && notaPanelAccess().get('ativo', false) == true
        && notaPanelAccess().get('role', '') in ['gerencia', 'superadmin'];
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function maxSize(sizeInMb) {
      return request.resource.size <= sizeInMb * 1024 * 1024;
    }

    // Bloqueia tudo por padrão
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Imagens de produtos
    // Usuários logados podem ler.
    // Apenas admin/gerência pode criar, editar ou apagar.
    match /produtos/{fileName} {
      allow read: if isSignedIn();

      allow create, update: if isAdmin()
        && isImage()
        && maxSize(5);

      allow delete: if isAdmin();
    }

    // Imagens gerais do sistema
    // Ex: banners, logos, imagens auxiliares.
    match /imagens/{fileName} {
      allow read: if isSignedIn();

      allow create, update: if isAdmin()
        && isImage()
        && maxSize(5);

      allow delete: if isAdmin();
    }

    // Fotos de perfil ficam no Storage; o Firestore guarda somente a URL.
    match /fotos_perfil/{userId}/{lojaId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && isImage()
        && request.resource.size <= 300 * 1024;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Notas fiscais seguem o acesso à loja e a permissão de gerenciar produtos.
    function notaPanelAccess() {
      return firestore.get(/databases/(default)/documents/acessos_painel/$(request.auth.uid)).data;
    }

    function canReadStoreNotes(lojaId) {
      let access = notaPanelAccess();
      return access.get('ativo', false) == true && (access.get('role', '') == 'superadmin'
        || access.get('lojaId', '') == lojaId
        || lojaId in access.get('lojaIds', []));
    }

    function canWriteStoreNotes(lojaId) {
      let access = notaPanelAccess();
      return canReadStoreNotes(lojaId) && (
        access.get('role', '') in ['superadmin', 'gerencia']
        || access.get('podeGerenciarProdutos', false) == true
      );
    }

    match /notas_fiscais/{lojaId}/{fileName} {
      allow read: if isSignedIn() && canReadStoreNotes(lojaId);
      allow create: if isSignedIn() && canWriteStoreNotes(lojaId)
        && request.resource.size > 0 && maxSize(10)
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'];
      allow delete: if isSignedIn() && canWriteStoreNotes(lojaId);
    }

    // Relatórios e PDFs
    // Apenas admin/gerência acessa.
    match /relatorios/{fileName} {
      allow read: if isAdmin();

      allow create, update: if isAdmin()
        && isPdf()
        && maxSize(10);

      allow delete: if isAdmin();
    }

    // Anexos gerais autenticados
    // Mantido mais restrito para evitar bagunça no Storage.
    match /anexos/{fileName} {
      allow read: if isSignedIn();

      allow create, update: if isSignedIn()
        && maxSize(10);

      allow delete: if isAdmin();
    }
  }
}
