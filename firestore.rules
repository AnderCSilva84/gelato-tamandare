rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function panelAccessPath(uid) {
      return /databases/$(database)/documents/acessos_painel/$(uid);
    }

    function hasPanelAccess() {
      return isSignedIn() && exists(panelAccessPath(request.auth.uid)) && myPanelAccess().data.get("ativo", false) == true;
    }

    function myPanelAccess() {
      return get(panelAccessPath(request.auth.uid));
    }

    function myRole() {
      return hasPanelAccess() ? myPanelAccess().data.role : null;
    }

    function isManagement() {
      return myRole() == "gerencia" || myRole() == "superadmin";
    }

    function isSuperadmin() {
      return myRole() == "superadmin";
    }

    function canManageProducts() {
      return isManagement()
        || (hasPanelAccess()
          && myPanelAccess().data.keys().hasAny(["podeGerenciarProdutos"])
          && myPanelAccess().data.podeGerenciarProdutos == true);
    }

    function hasStoreAccess(lojaId) {
      return hasPanelAccess() && (
        isSuperadmin()
        || (myPanelAccess().data.keys().hasAny(["lojaId"]) && myPanelAccess().data.lojaId == lojaId)
        || (myPanelAccess().data.keys().hasAny(["lojaIds"]) && lojaId in myPanelAccess().data.lojaIds)
      );
    }

    function canReadStoreData() {
      return resource.data.keys().hasAny(["uid"]) && hasStoreAccess(resource.data.uid);
    }

    function canCreateStoreData() {
      return request.resource.data.keys().hasAny(["uid"]) && hasStoreAccess(request.resource.data.uid);
    }

    function keepsStore() {
      return request.resource.data.uid == resource.data.uid;
    }

    function attendeePath(id) {
      return /databases/$(database)/documents/atendentes/$(id);
    }

    function attendeeDoc(id) {
      return get(attendeePath(id));
    }

    function attendeeExists(id) {
      return exists(attendeePath(id));
    }

    function isPromotingToSuperadmin() {
      return request.resource.data.role == "superadmin";
    }

    function isStoredSuperadmin() {
      return resource.data.role == "superadmin";
    }

    match /acessos_painel/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperadmin());
      allow write: if false;
    }

    // Only synthetic login addresses, never passwords or personal email addresses.
    match /logins_atendentes/{alias} { allow get: if true; allow list, write: if false; }

    match /atendentes/{document} {
      allow read: if canReadStoreData();
      allow write: if false;
    }

    match /configuracoes/{document} {
      allow read: if true;
      allow write: if isSuperadmin();
    }

    match /lojas/{lojaId} {
      allow read: if true;
      allow create: if isSuperadmin();
      allow update: if isSuperadmin()
        || (isManagement()
          && hasStoreAccess(lojaId) && resource.data.status == "ativa"
          && request.resource.data.status == "ativa"
          && request.resource.data.ativa == true);
      allow delete: if isSuperadmin();
    }

    match /produtos/{document=**} {
      allow read: if canReadStoreData();
      allow create: if canManageProducts() && canCreateStoreData() && request.resource.data.estoque is number && request.resource.data.estoque >= 0 && (!('giroDiario' in request.resource.data) || (request.resource.data.giroDiario is map && request.resource.data.giroDiario.size() == 0)) && (!('giroInicializado' in request.resource.data) || request.resource.data.giroInicializado == true);
      allow update: if canManageProducts() && canReadStoreData() && keepsStore() && request.resource.data.estoque is number && request.resource.data.estoque >= 0 && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['giroDiario', 'giroInicializado']);
      allow delete: if canManageProducts() && canReadStoreData();
    }

    match /movimentacoes_estoque/{document=**} {
      allow read: if canReadStoreData();
      allow create: if canManageProducts() && canCreateStoreData();
      allow update, delete: if false;
    }

    match /grupos_produtos/{document=**} {
      allow read: if canReadStoreData();
      allow create: if canManageProducts() && canCreateStoreData();
      allow update, delete: if canManageProducts() && canReadStoreData() && keepsStore();
    }

    match /vendas/{document=**} {
      allow read: if canReadStoreData();
      allow write: if false;
    }

    match /despesas/{document=**} {
      allow read: if canReadStoreData();
      allow write: if false;
    }

    match /despesas_fixas/{document=**} {
      allow read, delete: if isManagement() && canReadStoreData();
      allow create: if isManagement() && canCreateStoreData();
      allow update: if isManagement() && canReadStoreData() && keepsStore();
    }

    match /entradas_consolidadas/{document=**} {
      allow read: if canReadStoreData();
      allow write: if false;
    }

    match /caixas/{document=**} {
      allow read: if canReadStoreData();
      allow write: if false;
    }

    match /retiradas_caixa/{document=**} {
      allow read: if canReadStoreData();
      allow write: if false;
    }

    match /resumo_diario/{document=**} {
      allow read: if canReadStoreData();
      allow write: if false;
    }

    match /ranking_diario/{document=**} {
      allow read: if canReadStoreData();
      allow write: if false;
    }

    match /operacoes/{document} { allow read: if canReadStoreData(); allow write: if false; }
    match /auditoria_financeira/{document} { allow read: if isManagement() && canReadStoreData(); allow write: if false; }
    match /caixas_ativos/{document} { allow read: if canReadStoreData(); allow write: if false; }

    match /lancamentos/{document=**} {
      allow read: if canReadStoreData();
      allow delete: if isManagement() && canReadStoreData() && resource.data.tipo != "cancelamento_venda_caixa";
      allow create: if isManagement() && canCreateStoreData() && request.resource.data.tipo != "cancelamento_venda_caixa";
      allow update: if isManagement() && canReadStoreData() && keepsStore() && resource.data.tipo != "cancelamento_venda_caixa" && request.resource.data.tipo != "cancelamento_venda_caixa";
    }

    match /conversas/{conversaId} {
      function ownsConversation() {
        return hasPanelAccess() && request.auth.uid == conversaId;
      }
      allow read: if ownsConversation() || isSuperadmin();
      allow create: if ownsConversation()
        && request.resource.data.usuarioUid == request.auth.uid
        && request.resource.data.usuarioEmail == request.auth.token.email;
      allow update: if (ownsConversation() || isSuperadmin())
        && request.resource.data.usuarioUid == resource.data.usuarioUid
        && request.resource.data.usuarioEmail == resource.data.usuarioEmail;
      allow delete: if false;
      match /mensagens/{mensagemId} {
        allow read: if ownsConversation() || isSuperadmin();
        allow create: if request.resource.data.texto is string
          && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 4000
          && ((ownsConversation() && request.resource.data.tipoRemetente == "usuario"
            && request.resource.data.remetente == request.auth.token.email)
          || (isSuperadmin() && request.resource.data.tipoRemetente == "admin"
            && request.resource.data.adminEmail == request.auth.token.email
            && request.resource.data.remetente == "admin"));
        allow update, delete: if false;
      }
    }
  }
}
